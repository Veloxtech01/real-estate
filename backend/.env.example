# Copy to .env and fill in real values. NEVER commit .env (see root .gitignore).

# --- Core ---
NODE_ENV=development
PORT=5000
# Origin allowed to send credentialed (cookie) requests — the Next.js client.
CLIENT_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---
# Atlas connection string. Leave unset to boot the API without a database.
# Shared cluster: paste the string from Atlas WITHOUT a database path — the database
# is chosen by MONGODB_DB_NAME below, not by the URI.
MONGODB_URI=
# ALWAYS set this on a shared cluster. Without it Mongoose silently uses "test",
# which on a shared cluster means another project's data.
# dev: realestate_dev   prod: realestate_prod
MONGODB_DB_NAME=realestate_dev

# --- Auth (cookie-based JWT) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Media uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
# Address enquiry/viewing notifications are sent from.
MAIL_FROM=

# --- AI natural-language search (scope doc §5) ---
# Small/fast model only — it extracts filters, it never writes listing copy.
AI_SEARCH_API_KEY=
AI_SEARCH_MODEL=
# Feature flag + spend guard required by §5.6: disable AI search and fall back to
# the ordinary filter UI when the cap is hit or the provider is unavailable.
AI_SEARCH_ENABLED=false
AI_SEARCH_MONTHLY_CAP_USD=
